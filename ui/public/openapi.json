{
  "openapi": "3.0.3",
  "info": {
    "title": "HomeAgent API",
    "description": "Matter 스마트홈 허브 REST API. Go 백엔드가 matterjs-server(Matter 프로토콜 엔진)를 제어하여 Thread/WiFi Matter 디바이스를 관리합니다.",
    "version": "0.9.0",
    "contact": {
      "name": "HomeAgent",
      "url": "https://github.com/junghan0611/homeagent-config"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "로컬 개발 서버"
    },
    {
      "url": "http://{host}:8080",
      "description": "보드 (RK3576/RPi5)",
      "variables": {
        "host": {
          "default": "192.168.1.100",
          "description": "보드 IP 주소"
        }
      }
    }
  ],
  "tags": [
    {"name": "Health", "description": "서버 상태 확인"},
    {"name": "Devices", "description": "디바이스 조회/제어/삭제"},
    {"name": "Commission", "description": "새 디바이스 페어링"},
    {"name": "Events", "description": "실시간 이벤트 스트림 (SSE)"},
    {"name": "Agent", "description": "LLM 에이전트 + A2UI"},
    {"name": "Thread", "description": "Thread Border Router 상태"},
    {"name": "A2A", "description": "Agent-to-Agent 프로토콜"}
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": ["Health"],
        "summary": "헬스체크",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "서버 정상",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string", "example": "ok"},
                    "version": {"type": "string", "example": "0.9.0"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/devices": {
      "get": {
        "tags": ["Devices"],
        "summary": "디바이스 목록 + 현재 상태",
        "operationId": "getDevices",
        "responses": {
          "200": {
            "description": "디바이스 목록",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {"$ref": "#/components/schemas/DeviceState"}
                },
                "example": [
                  {
                    "node_id": 1,
                    "name": "현관문 센서",
                    "room": "현관",
                    "type": "contact_sensor",
                    "available": true,
                    "state": {"contact": false}
                  },
                  {
                    "node_id": 8,
                    "name": "거실 플러그",
                    "room": "거실",
                    "type": "on_off_plug",
                    "available": true,
                    "state": {"on": true}
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/api/devices/{node_id}": {
      "get": {
        "tags": ["Devices"],
        "summary": "개별 디바이스 상세 조회",
        "operationId": "getDeviceByID",
        "parameters": [
          {
            "name": "node_id",
            "in": "path",
            "required": true,
            "schema": {"type": "integer"},
            "description": "Matter 노드 ID",
            "example": 8
          }
        ],
        "responses": {
          "200": {
            "description": "디바이스 상세",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/DeviceState"}
              }
            }
          },
          "400": {
            "description": "잘못된 node_id",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"}
              }
            }
          },
          "404": {
            "description": "디바이스 없음",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"},
                "example": {"error": "device not found"}
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Devices"],
        "summary": "디바이스 삭제 (unpair)",
        "operationId": "deleteDevice",
        "parameters": [
          {
            "name": "node_id",
            "in": "path",
            "required": true,
            "schema": {"type": "integer"},
            "example": 4
          }
        ],
        "responses": {
          "200": {
            "description": "삭제 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string", "example": "ok"}
                  }
                }
              }
            }
          },
          "404": {
            "description": "디바이스 없음",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"}
              }
            }
          },
          "500": {
            "description": "Matter 에러",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"},
                "example": {"error": "remove_node error 3: node not found in fabric"}
              }
            }
          }
        }
      }
    },
    "/api/devices/command": {
      "post": {
        "tags": ["Devices"],
        "summary": "디바이스 제어 명령",
        "operationId": "sendCommand",
        "description": "8개 명령 지원: on, off, set_level, set_color, set_color_temp, set_thermostat, lock, unlock",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/CommandRequest"},
              "examples": {
                "on": {
                  "summary": "플러그/조명 켜기",
                  "value": {"node_id": 8, "command": "on"}
                },
                "off": {
                  "summary": "플러그/조명 끄기",
                  "value": {"node_id": 8, "command": "off"}
                },
                "set_level": {
                  "summary": "밝기 조절",
                  "value": {"node_id": 5, "command": "set_level", "level": 128, "transition_time": 10}
                },
                "set_color": {
                  "summary": "색상 변경",
                  "value": {"node_id": 5, "command": "set_color", "hue": 120, "saturation": 200}
                },
                "set_color_temp": {
                  "summary": "색온도 변경",
                  "value": {"node_id": 5, "command": "set_color_temp", "color_temp": 300}
                },
                "set_thermostat": {
                  "summary": "온도 설정",
                  "value": {"node_id": 3, "command": "set_thermostat", "mode": "heat", "temperature": 2200}
                },
                "lock": {
                  "summary": "도어락 잠금",
                  "value": {"node_id": 2, "command": "lock"}
                },
                "unlock": {
                  "summary": "도어락 해제",
                  "value": {"node_id": 2, "command": "unlock"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "명령 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string", "example": "ok"}
                  }
                }
              }
            }
          },
          "400": {
            "description": "잘못된 명령 또는 누락된 필드",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"},
                "example": {"error": "unknown command", "commands": ["on","off","set_level","set_color","set_color_temp","set_thermostat","lock","unlock"]}
              }
            }
          },
          "500": {
            "description": "디바이스 통신 에러",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"}
              }
            }
          }
        }
      }
    },
    "/api/commission": {
      "post": {
        "tags": ["Commission"],
        "summary": "디바이스 페어링 (BLE/on-network)",
        "operationId": "commission",
        "description": "Matter 디바이스를 페어링합니다. 비동기 (60-180초). 결과는 SSE /api/events로 전달됩니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code"],
                "properties": {
                  "code": {
                    "type": "string",
                    "description": "Matter 설정 코드 (QR의 MT:... 또는 11자리 숫자)",
                    "example": "34970112332"
                  },
                  "network_only": {
                    "type": "boolean",
                    "default": false,
                    "description": "true면 BLE 우회, on-network만 시도"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "커미셔닝 시작됨 (비동기)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string", "example": "commissioning"},
                    "code": {"type": "string", "example": "34970112332"}
                  }
                }
              }
            }
          },
          "400": {
            "description": "code 누락",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"}
              }
            }
          },
          "409": {
            "description": "커미셔닝이 이미 진행 중",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"}
              }
            }
          }
        }
      }
    },
    "/api/commission-on-network": {
      "post": {
        "tags": ["Commission"],
        "summary": "IP 직접 지정 페어링 (CASE)",
        "operationId": "commissionOnNetwork",
        "description": "BLE 우회. IP 주소로 직접 Matter CASE 커미셔닝. BLE 커미셔닝 실패 시 우회용.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["pin_code"],
                "properties": {
                  "pin_code": {
                    "type": "integer",
                    "description": "디바이스 setup PIN code",
                    "example": 56204424
                  },
                  "ip_addr": {
                    "type": "string",
                    "description": "IPv6/IPv4 주소 (미지정 시 mDNS 자동 탐색)",
                    "example": "fd3f:a8c0:1556:1:5ea6:9e21:f21e:cb08"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "커미셔닝 시작됨 (비동기)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {"type": "string", "example": "commissioning"},
                    "pin_code": {"type": "integer"}
                  }
                }
              }
            }
          },
          "400": {
            "description": "pin_code 누락",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"}
              }
            }
          }
        }
      }
    },
    "/api/wifi-credentials": {
      "post": {
        "tags": ["Commission"],
        "summary": "WiFi 자격증명 설정",
        "operationId": "setWifiCredentials",
        "description": "Matter WiFi 디바이스 커미셔닝 전에 WiFi 정보를 설정합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ssid"],
                "properties": {
                  "ssid": {"type": "string", "example": "MyWiFi"},
                  "password": {"type": "string", "example": "secret123"}
                }
              }
            }
          }
        },
        "responses": {
          "204": {"description": "설정 완료"},
          "400": {
            "description": "SSID 누락",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"}
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": ["Agent"],
        "summary": "LLM 에이전트 자연어 명령",
        "operationId": "chat",
        "description": "자연어로 디바이스를 제어합니다. OPENROUTER_API_KEY 필요.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message"],
                "properties": {
                  "message": {"type": "string", "example": "거실 플러그 꺼줘"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "에이전트 응답",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ChatResult"},
                "example": {
                  "reply": "거실 플러그를 끄겠습니다.",
                  "actions": [{"action_type": "off", "node_id": 8}]
                }
              }
            }
          },
          "400": {"description": "message 누락"},
          "503": {
            "description": "LLM 미설정 (OPENROUTER_API_KEY 없음)",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"}
              }
            }
          }
        }
      }
    },
    "/api/home": {
      "get": {
        "tags": ["Agent"],
        "summary": "A2UI Home Surface",
        "operationId": "getHomeSurface",
        "description": "시간 기반 동적 UI 데이터. 에이전트가 테마, 인사말, 디바이스 요약 카드를 생성합니다.",
        "responses": {
          "200": {
            "description": "Home Surface JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "A2UI Surface JSON (스키마는 동적)"
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "tags": ["Events"],
        "summary": "SSE 실시간 이벤트 스트림",
        "operationId": "subscribeEvents",
        "description": "Server-Sent Events. 연결 시 snapshot(현재 디바이스 목록) 후 실시간 이벤트가 전달됩니다.\n\n이벤트 타입: device_state, device_added, device_removed, commission_error, agent_message, surface_update",
        "responses": {
          "200": {
            "description": "SSE 스트림",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "data: {JSON}\\n\\n 형식"
                }
              }
            }
          }
        }
      }
    },
    "/api/thread/status": {
      "get": {
        "tags": ["Thread"],
        "summary": "Thread Border Router 상태",
        "operationId": "getThreadStatus",
        "description": "OTBR REST API로 Thread 네트워크 상태를 조회합니다. OTBR이 실행 중이어야 합니다.",
        "responses": {
          "200": {
            "description": "Thread 상태",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ThreadStatus"},
                "example": {
                  "state": "leader",
                  "rloc16": "0x0400",
                  "ext_addr": "dead00beef00cafe",
                  "dataset": {
                    "NetworkName": "OpenThread-1234",
                    "Channel": 15,
                    "PanId": "0x1234"
                  }
                }
              }
            }
          },
          "503": {
            "description": "OTBR 미실행",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"},
                "example": {
                  "error": "otbr state: otbr GET /node/state: dial tcp ...: connection refused",
                  "hint": "OTBR이 실행 중인지 확인하세요 (./run.sh android thread-start)"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/agent.json": {
      "get": {
        "tags": ["A2A"],
        "summary": "A2A AgentCard",
        "operationId": "getAgentCard",
        "description": "Agent-to-Agent 프로토콜의 AgentCard. 에이전트 능력, 엔드포인트 정보를 노출합니다.",
        "responses": {
          "200": {
            "description": "AgentCard JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "A2A AgentCard (RFC 스펙)"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeviceState": {
        "type": "object",
        "properties": {
          "node_id": {"type": "integer", "description": "Matter 노드 ID", "example": 8},
          "name": {"type": "string", "description": "디바이스 별칭", "example": "거실 플러그"},
          "room": {"type": "string", "description": "방 이름", "example": "거실"},
          "type": {
            "type": "string",
            "description": "디바이스 타입",
            "enum": ["contact_sensor", "on_off_light", "dimmable_light", "on_off_plug", "color_temp_light", "extended_color_light", "temperature_sensor", "humidity_sensor"],
            "example": "on_off_plug"
          },
          "available": {"type": "boolean", "description": "연결 상태", "example": true},
          "state": {
            "type": "object",
            "description": "타입별 상태 값",
            "additionalProperties": true,
            "example": {"on": true, "level": 200}
          }
        },
        "required": ["node_id", "name", "type", "available", "state"]
      },
      "CommandRequest": {
        "type": "object",
        "required": ["node_id", "command"],
        "properties": {
          "node_id": {"type": "integer", "description": "대상 디바이스 노드 ID"},
          "command": {
            "type": "string",
            "enum": ["on", "off", "set_level", "set_color", "set_color_temp", "set_thermostat", "lock", "unlock"]
          },
          "level": {"type": "integer", "minimum": 0, "maximum": 254, "description": "밝기 (set_level)"},
          "hue": {"type": "integer", "minimum": 0, "maximum": 254, "description": "색상 (set_color)"},
          "saturation": {"type": "integer", "minimum": 0, "maximum": 254, "description": "채도 (set_color)"},
          "color_temp": {"type": "integer", "minimum": 153, "maximum": 500, "description": "색온도 mireds (set_color_temp)"},
          "temperature": {"type": "integer", "description": "온도 0.01°C 단위 (set_thermostat)"},
          "mode": {"type": "string", "enum": ["heat", "cool"], "description": "모드 (set_thermostat)"},
          "transition_time": {"type": "integer", "default": 0, "description": "전환 시간 (100ms 단위)"}
        }
      },
      "ChatResult": {
        "type": "object",
        "properties": {
          "reply": {"type": "string", "description": "에이전트 텍스트 응답"},
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action_type": {"type": "string"},
                "node_id": {"type": "integer"}
              }
            }
          },
          "surface": {
            "type": "object",
            "description": "A2UI 동적 Surface (선택)"
          }
        }
      },
      "ThreadStatus": {
        "type": "object",
        "properties": {
          "state": {"type": "string", "description": "Thread 상태", "enum": ["leader", "router", "child", "detached", "disabled"]},
          "rloc16": {"type": "string", "example": "0x0400"},
          "ext_addr": {"type": "string", "example": "dead00beef00cafe"},
          "dataset": {"type": "object", "description": "Thread operational dataset"},
          "leader_data": {"type": "object", "description": "리더 정보"}
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {"type": "string", "description": "에러 메시지"}
        },
        "required": ["error"]
      }
    }
  }
}
