# HomeAgent RPi5 환경변수
# run.sh가 이 파일을 읽어서 RPi5에 전달합니다.
# OPENROUTER_API_KEY는 ~/.env.local에서 가져옵니다.

HOMEAGENT_HTTP_ADDR=:8080
HOMEAGENT_MATTER_WS=ws://localhost:5580
HOMEAGENT_UI_DIR=/opt/homeagent/ui
HOMEAGENT_ALIASES_FILE=/opt/homeagent/aliases.json
HOMEAGENT_WIFI_SSID='TP-Link_E426'
HOMEAGENT_WIFI_PASSWORD='93666367'
HOMEAGENT_LLM_MODEL=google/gemini-2.5-flash
