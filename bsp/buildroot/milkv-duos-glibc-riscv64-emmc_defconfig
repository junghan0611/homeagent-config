# HomeAgent SG2000 service image -- Buildroot config (glibc x riscv64).
#
# The stock SDK ships glibc only for arm64 and riscv64 only with musl, so this
# combination does not exist upstream. It is the N0 "service image" lane:
#   musl  x riscv64 -> homeagentd minimal baseline (stock boards, untouched)
#   glibc x riscv64 -> Node / Z2M service image (this file)
#
# DERIVED from buildroot/configs/milkv-duos-musl-riscv64-emmc_defconfig so that the
# vendor's own requirements come along (cvi-pinmux SoC selection, rootfs targets,
# package set). Only the deltas below are ours; each one is commented in place.
#
# Install into the SDK as buildroot/configs/<name>_defconfig, then:
#   make O=output/milkv-duos-glibc-riscv64-emmc milkv-duos-glibc-riscv64-emmc_defconfig
#   make O=output/milkv-duos-glibc-riscv64-emmc nodejs

BR2_riscv=y

# DELTA: Buildroot composes -march from the BR2_RISCV_ISA_* symbols
# (arch/arch.mk.riscv) and the external-toolchain wrapper forces that -march on
# compile AND link. RVC has no "default y", so without this line the target would
# be rv64imafd: no compressed instructions, larger code, and an ISA that diverges
# from the measured SMHub contract (rv64...c2p0). RVV stays off deliberately.
BR2_RISCV_ISA_RVC=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
# DELTA: the glibc riscv64 cross toolchain already shipped in the SDK's host-tools
# (Xuantie-900 linux-5.10.4 glibc GCC 10.2.0). Same toolchain the G0 snapshot-seam
# experiment measured against; satisfies the host gate (GLIBC 2.33, GCC >= 10.1).
BR2_TOOLCHAIN_EXTERNAL_PATH="$(TOPDIR)/../host-tools/gcc/riscv64-linux-x86_64"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="riscv64-unknown-linux-gnu"
BR2_TOOLCHAIN_EXTERNAL_GCC_10=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_5_10=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
# DELTA: the glibc toolchain ships riscv64-unknown-linux-gnu-gfortran while the musl
# one does not, and Buildroot refuses to configure an external toolchain whose Fortran
# support is present but unselected. The stock *glibc* arm64 board carries this line
# for the same reason; deriving from the musl board is what drops it.
BR2_TOOLCHAIN_EXTERNAL_FORTRAN=y
# DELTA: BR2_TOOLCHAIN_EXTERNAL_INET_RPC defaults to y for glibc toolchains, but this
# glibc is 2.33, which no longer ships Sun RPC -- sysroot/usr/include/rpc/ holds only
# netdb.h, no rpc.h, which is exactly what Buildroot's check_glibc_rpc_feature tests
# for. libtirpc is the replacement if anything ever needs RPC. Must be forced off;
# the musl board never hit this because the symbol depends on !MUSL.
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y
# DELTA: the stock board carries
#   BR2_TARGET_LDFLAGS="-march=rv64imafdcv0p7xthead -mcpu=c906fdv -mabi=lp64d -mcmodel=medany"
# i.e. the C906's *draft* RVV 0.7. The host gate requires no RVV in shipped service
# binaries, so the whole line is dropped rather than edited:
#   -march / -mabi   already forced by the toolchain wrapper from BR2_RISCV_ISA_*.
#   RVV 0.7          off by leaving BR2_RISCV_ISA_RVV unset.
#   -mcmodel=medany  only ever reached the link step here, never the compile step,
#                    so it was not doing what it looks like it does. Node's ~75MB is
#                    nowhere near medlow's +/-2GiB reach, so the first proof runs
#                    without it; a measured relocation failure would have to put it
#                    in CFLAGS/CXXFLAGS *and* link, not LDFLAGS alone.
# Result: generic rv64gc/lp64d on /lib/ld-linux-riscv64-lp64d.so.1 -- the loader the
# host gate names (verified directly against the SDK toolchain).
BR2_OPTIMIZE_S=y
BR2_PER_PACKAGE_DIRECTORIES=y
BR2_TARGET_GENERIC_HOSTNAME="milkv-duo"
BR2_TARGET_GENERIC_ISSUE="HomeAgent SG2000 service image (glibc/riscv64)"
BR2_TARGET_GENERIC_ROOT_PASSWD="milkv"
# DELTA: no rootfs overlay yet -- this lane's first gate is `make nodejs`, not a
# bootable image. An overlay lands with the board variant (N1).
