# HomeAgent: Orange Pi 5 (RK3588S) SD Card Image Layout
# Based on Rockchip GPT partition scheme for RK3588
# Reference: https://opensource.rock-chips.com/wiki_Partitions
#
# RK3588 boot chain: idblock (SPL) → uboot → boot.img (kernel+DTB) → rootfs
# trust.img is NOT needed — ATF is embedded in uboot.img

bootloader --ptable gpt

# SPL (idblock) at sector 64
part --source rawcopy --sourceparams="file=idblock.img" --align 32 --no-table

# U-Boot proper at 2MB offset (matches JeffyCN layout)
part --source rawcopy --sourceparams="file=uboot.img" --part-name uboot --offset 2M

# boot.img (kernel Image + DTB, Android boot format)
part --source rawcopy --sourceparams="file=boot.img" --part-name boot --align 4

# Root filesystem
part / --source rootfs --fstype ext4 --part-name rootfs --align 8192 --mkfs-extraopts "-O ^metadata_csum"
