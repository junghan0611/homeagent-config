 define NODEJS_SRC_WRAPPER_FIXUP
 	$(SED) "s%@MAYBE_WRAPPER@%'<(PRODUCT_DIR)/v8-qemu-wrapper',%g" $(@D)/node.gyp
 	$(SED) "s%@MAYBE_WRAPPER@%'<(PRODUCT_DIR)/v8-qemu-wrapper',%g" $(@D)/tools/v8_gypfiles/v8.gyp
 endef
+
+# riscv64 is the same bit width as the build host, so V8's host tools are built
+# with the HOST toolchain and run natively -- no target binary is ever executed.
+# V8 turns on its RISC-V simulator by itself in that configuration
+# (globals.h: V8_TARGET_ARCH_RISCV64 && !V8_HOST_ARCH_RISCV64 -> USE_SIMULATOR),
+# so an x86-64 mksnapshot serializes a riscv64 snapshot. Measured, see
+# docs/BUILDROOT.md in the homeagent-config repo.
+ifeq ($(BR2_RISCV_64),y)
+# The ninja generator cannot be used together with want_separate_host_toolset:
+# v8_inspector_headers is declared for both toolsets but writes into the shared
+# gen/ directory, so both emit the same js_protocol.stamp edge and ninja aborts
+# with "multiple rules generate". The make generator accepts it.
+NODEJS_SRC_GENERATOR =
+# The generated out/Makefile hardcodes "CC.host ?= cc" -- gyp does NOT bake the
+# configure-time CC_host into it (see the TODO(evan) comment it emits), and make
+# cannot read an env var named "CC.host". So the host toolset has to be handed to
+# the build step as make command-line variables; the configure-time _host env below
+# only steers configure.py's own host_arch detection. Measured: exporting a bogus
+# CC_host still yields "CC.host ?= cc" in out/Makefile.
+NODEJS_SRC_MAKE_OPTS += \
+	CC.host="$(HOSTCC)" \
+	CXX.host="$(HOSTCXX)" \
+	LINK.host="$(HOSTCXX)" \
+	AR.host="$(HOSTAR)" \
+	CFLAGS.host="$(HOST_CFLAGS)" \
+	CXXFLAGS.host="$(HOST_CXXFLAGS)" \
+	LDFLAGS.host="$(HOST_LDFLAGS)"
+# NOTE: NODEJS_SRC_CONFIGURE_CMDS is a hand-written define that spells out its own
+# environment, so <pkg>_CONF_ENV is NOT consulted here. These have to be injected
+# into the configure command line itself (see NODEJS_SRC_CONFIGURE_CMDS below).
+NODEJS_SRC_HOST_TOOLSET_ENV = \
+	CC_host="$(HOSTCC)" \
+	CXX_host="$(HOSTCXX)" \
+	LINK_host="$(HOSTCXX)" \
+	AR_host="$(HOSTAR)" \
+	CFLAGS_host="$(HOST_CFLAGS)" \
+	CXXFLAGS_host="$(HOST_CXXFLAGS)" \
+	LDFLAGS_host="$(HOST_LDFLAGS)"
+define NODEJS_SRC_WRAPPER_FIXUP_NONE
+	$(SED) "s%@MAYBE_WRAPPER@%%g" $(@D)/node.gyp
+	$(SED) "s%@MAYBE_WRAPPER@%%g" $(@D)/tools/v8_gypfiles/v8.gyp
+endef
+NODEJS_SRC_PRE_CONFIGURE_HOOKS += NODEJS_SRC_WRAPPER_FIXUP_NONE
+
+# A real separate host toolset means every --shared-* dependency that a *host* tool
+# pulls in must also exist for the host. Buildroot's stock qemu path never notices
+# this: there the "host" toolset is the target toolchain, so the target staging dir
+# satisfies those includes. Here tools/js2c.cc -> tools/executable_wrapper.h needs
+# uv.h, and node.gyp hands every --shared-* library to the host link too, so
+# node_js2c is linked with -lz -luv -lcares -lnghttp2 -lcrypto -lssl against the
+# *target* sysroot ("skipping incompatible ... cannot find -lcares"). Buildroot's
+# HOST_LDFLAGS -L comes first, so providing host builds of those libraries resolves
+# it. host-c-ares/host-zlib/host-libopenssl already existed; host-libuv and
+# host-nghttp2 did not, so those two packages gain a host variant.
+NODEJS_SRC_DEPENDENCIES += \
+	host-c-ares \
+	host-libuv \
+	host-nghttp2 \
+	host-zlib
+ifeq ($(BR2_PACKAGE_OPENSSL),y)
+NODEJS_SRC_DEPENDENCIES += host-libopenssl
+endif
+ifeq ($(BR2_PACKAGE_ICU),y)
+NODEJS_SRC_DEPENDENCIES += host-icu
+endif
+# A runtime-only riscv64 image must not inherit Node's default Corepack install
+# when Buildroot's target NPM option is off.
+ifneq ($(BR2_PACKAGE_NODEJS_NPM),y)
+NODEJS_SRC_CONF_OPTS += --without-corepack
+endif
+else
+NODEJS_SRC_GENERATOR = --ninja
+NODEJS_SRC_HOST_TOOLSET_ENV =
+NODEJS_SRC_DEPENDENCIES += host-qemu
+NODEJS_SRC_PRE_CONFIGURE_HOOKS += NODEJS_SRC_INSTALL_V8_QEMU_WRAPPER
 NODEJS_SRC_PRE_CONFIGURE_HOOKS += NODEJS_SRC_WRAPPER_FIXUP
+endif
 
 # Do not run the qemu-wrapper for the host build.
 define HOST_NODEJS_SRC_WRAPPER_FIXUP
@@ -206,6 +273,7 @@ HOST_NODEJS_SRC_PRE_CONFIGURE_HOOKS += HOST_NODEJS_SRC_WRAPPER_FIXUP
 define NODEJS_SRC_CONFIGURE_CMDS
 	(cd $(@D); \
 		$(TARGET_CONFIGURE_OPTS) \
+		$(NODEJS_SRC_HOST_TOOLSET_ENV) \
 		PATH=$(@D)/bin:$(BR_PATH) \
 		LDFLAGS="$(NODEJS_SRC_LDFLAGS)" \
 		LD="$(TARGET_CXX)" \
