# DELTA: Node 22.22.0 through the riscv64 pure-cross recipe
# (bsp/patches/0002-buildroot-nodejs-riscv64-pure-cross.patch). OpenSSL is shared
# from Buildroot rather than Node's bundle; --without-ssl is not a product path
# because Z2M needs TLS.
BR2_PACKAGE_NODEJS=y
BR2_PACKAGE_OPENSSL=y

